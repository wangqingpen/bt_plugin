<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="-1">
      <Sequence name="ACT完成后回位_循环">
        <RunActUntilGripperDone
            name="ACT闭合张开完成确认"
            robot_sel="0"
            gripper_model="1"
            closed_mm="30"
            finish_opening_mm="65"
            tolerance_mm="1"
            closed_stable_ms="200"
            stable_ms="500"
            feedback_timeout_ms="1000"
            timeout_ms="120000"
            command_timeout_ms="2000"
            phase="{act_phase}"
            error="{act_error}"/>
        <!-- Configure the target name and speed here. Joint angles are radians. -->
        <MoveAbsJJointTarget
            name="回到原位"
            robot_sel="0"
            jointtarget="pick_home"
            speed="v50"
            timeout_ms="60000"
            feedback_timeout_ms="1000"
            idle_stable_ms="200"
            stable_ms="200"
            position_tolerance_rad="0.01"
            velocity_tolerance_rad_s="0.01"
            phase="{home_phase}"
            error="{home_error}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
