<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Repeat num_cycles="-1">
      <Sequence name="抓取成功后回位">
        <RetryPi05Grasp max_attempts="3" result="{pi05_result}" phase="{retry_phase}">
          <Sequence name="回位检查_夹爪张开_PI0.5">
            <MoveAbsJJointTarget name="启动前确认原位" robot_sel="0"
                jointtarget="pick_home" speed="v50" skip_if_at_target="true"
                timeout_ms="60000" feedback_timeout_ms="1000"
                idle_stable_ms="200" stable_ms="200"
                position_tolerance_rad="0.01" velocity_tolerance_rad_s="0.01"
                phase="{prepare_home_phase}" error="{prepare_home_error}"/>
            <!-- One gripper joint, in metres: 0.0625 +/- 0.0025 m = 60..65 mm. -->
            <MoveAbsJJointTarget name="启动前确认夹爪张开" robot_sel="1"
                feedback_subsystem="TwoFingersGripperSerialYSEG2#0#1"
                jointtarget_values="0.0625" speed="v50" skip_if_at_target="true"
                timeout_ms="10000" feedback_timeout_ms="1000"
                idle_stable_ms="200" stable_ms="200"
                position_tolerance_rad="0.0025" velocity_tolerance_rad_s="0.001"
                phase="{open_gripper_phase}" error="{open_gripper_error}"/>
            <RunPi05UntilGripperDone name="PI0.5抓取_小于5mm失败"
                robot_sel="0" gripper_model="1" subsystem_name="Pi05Inference#0#0"
                closed_mm="30" finish_opening_mm="62.5" tolerance_mm="2.5"
                closed_stable_ms="200" stable_ms="500"
                feedback_timeout_ms="1000" timeout_ms="120000" command_timeout_ms="2000"
                phase="{pi05_phase}" error="{pi05_error}" result="{pi05_result}"/>
          </Sequence>
          <MoveAbsJJointTarget name="抓取失败后回原位" robot_sel="0"
              jointtarget="pick_home" speed="v50" skip_if_at_target="true"
              timeout_ms="60000" feedback_timeout_ms="1000"
              idle_stable_ms="200" stable_ms="200"
              position_tolerance_rad="0.01" velocity_tolerance_rad_s="0.01"
              phase="{recovery_home_phase}" error="{recovery_home_error}"/>
        </RetryPi05Grasp>
        <MoveAbsJJointTarget name="成功后回原位" robot_sel="0"
            jointtarget="pick_home" speed="v50" skip_if_at_target="true"
            timeout_ms="60000" feedback_timeout_ms="1000"
            idle_stable_ms="200" stable_ms="200"
            position_tolerance_rad="0.01" velocity_tolerance_rad_s="0.01"
            phase="{home_phase}" error="{home_error}"/>
      </Sequence>
    </Repeat>
  </BehaviorTree>
</root>
